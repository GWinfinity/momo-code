#!/usr/bin/env node
/**
 * MOMO CODE v2.0 — CLI Entry Point
 *
 * Converged entry: Pi-based REPL agent for interactive mode,
 * legacy Node.js handlers for /evolve /fine-tune subcommands.
 */

import { spawn } from "child_process"
import { readFileSync } from "fs"
import { dirname, join } from "path"
import { fileURLToPath } from "url"

const __dirname = dirname(fileURLToPath(import.meta.url))

// ── Legacy commands (handled by existing Node.js CLI) ─────────────
const LEGACY_COMMANDS = new Set([
  "/evolve", "/fine-tune", "/finetune",
  "evolve", "fine-tune", "finetune",
  "models", "/optim", "optim", "/serve", "serve",
  "help", "--help", "-h",
  "version", "--version", "-v",
])

function isLegacyCommand(argv) {
  if (argv.length === 0) return false
  const first = argv[0]
  if (first.startsWith("/")) return true
  if (first === "-p" || first === "--provider") return true
  return LEGACY_COMMANDS.has(first)
}

// ── Argument parsing ──────────────────────────────────────────────
function parseArgs(argv) {
  if (isLegacyCommand(argv)) {
    return { mode: "legacy", legacyArgv: argv }
  }

  if (argv[0] === "exec" || argv[0] === "--exec") {
    const next = argv[1]
    if (next === "--json") {
      return { mode: "json", prompt: argv.slice(2).join(" "), legacyArgv: [] }
    }
    return { mode: "print", prompt: argv.slice(1).join(" "), legacyArgv: [] }
  }

  if (argv[0] === "--json") {
    return { mode: "json", prompt: argv.slice(1).join(" "), legacyArgv: [] }
  }

  if (argv.length === 0) {
    return { mode: "repl", legacyArgv: [] }
  }

  return { mode: "repl", prompt: argv.join(" "), legacyArgv: [] }
}

// ── Run legacy Node.js CLI ────────────────────────────────────────
function runLegacy(argv) {
  return import("../dist/cli/index.js")
    .then(({ runCli }) => runCli(argv))
    .catch((err) => {
      if (err.code === "ERR_MODULE_NOT_FOUND" || err.message?.includes("Cannot find module")) {
        console.error("\x1b[31mError:\x1b[0m Build output not found or ESM import broken.")
        console.error("Original error:", err.message)
        console.error("Try: npm run build")
      } else {
        console.error(`\x1b[31mError:\x1b[0m ${err.message}`)
        if (err.stack) console.error(err.stack)
      }
      process.exit(1)
    })
}

// ── Run Pi agent (REPL / print / json) ────────────────────────────
async function runPiAgent(args) {
  try {
    const { createAgentSession } = await import("@earendil-works/pi-coding-agent")
    const {
      experienceExtension,
      rsiExtension,
      brandExtension,
      permissionsExtension,
      decisionsExtension,
      cotExtension,
    } = await import("../dist/pi-extensions/index.js")

    const session = createAgentSession({
      extensions: [
        brandExtension,
        experienceExtension,
        permissionsExtension,
        decisionsExtension,
        cotExtension,
        rsiExtension,
      ],
      interactive: args.mode === "repl",
      outputMode: args.mode === "json" ? "jsonl" : "text",
    })

    if (args.prompt) {
      await session.startTask(args.prompt)
    } else {
      await session.startRepl()
    }
  } catch (err) {
    if (err.code === "ERR_MODULE_NOT_FOUND" || err.message?.includes("Cannot find module")) {
      console.warn("⚠️  Pi runtime not installed. Using momo native REPL.")
      console.warn("   Install Pi: npm install @earendil-works/pi-coding-agent@1.1.0")
      console.warn("")
      await runNativeRepl(args)
    } else {
      throw err
    }
  }
}

// ── Native REPL fallback (no Pi required) ─────────────────────────
async function runNativeRepl(args) {
  // Use tsx to run the TypeScript REPL directly
  const tsx = spawn(
    "npx",
    ["tsx", "src/repl/index.ts", args.mode, args.prompt || ""],
    {
      cwd: join(__dirname, ".."),
      stdio: "inherit",
      shell: true,
    }
  )

  return new Promise((resolve, reject) => {
    tsx.on("close", (code) => {
      if (code === 0) resolve()
      else reject(new Error(`REPL exited with code ${code}`))
    })
  })
}

// ── Version ───────────────────────────────────────────────────────
function showVersion() {
  try {
    const pkg = JSON.parse(readFileSync(join(__dirname, "..", "package.json"), "utf8"))
    console.log(pkg.version || "0.1.0")
  } catch {
    console.log("0.1.0")
  }
}

// ── Main ──────────────────────────────────────────────────────────
const argv = process.argv.slice(2)

if (["version", "--version", "-v"].includes(argv[0])) {
  showVersion()
  process.exit(0)
}

if (["help", "--help", "-h"].includes(argv[0])) {
  await runLegacy(argv)
  process.exit(0)
}

const args = parseArgs(argv)

if (args.mode === "legacy") {
  runLegacy(args.legacyArgv)
} else {
  runPiAgent(args).catch((err) => {
    console.error("\x1b[31mError:\x1b[0m", err.message)
    process.exit(1)
  })
}
