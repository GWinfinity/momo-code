{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "momocode",
  "version": "1.0.0",
  "description": "AI-powered coding agent -- momo Code",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd packages/opencode && npm run dev",
    "typecheck": "cd packages/opencode && npm run typecheck",
    "lint": "cd packages/opencode && npm run lint",
    "test": "cd packages/opencode && npm test",
    "build": "cd packages/opencode && npm run build",
    "loop": "cd packages/opencode && node dist/rsi/index.js",
    "bench": "cd packages/opencode && node dist/momo-bench/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/momozi1996/momo-code"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
